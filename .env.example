# NOTE: ADMIN_KEY (the old shared admin key) has been replaced by a real
# email+password admin login — see ADMIN_EMAIL below. ADMIN_KEY is no
# longer read anywhere in the app; you can remove it from your real .env
# whenever convenient, there's nothing left that checks it.

# PostgreSQL connection string (Neon). Required — the app will not start
# usefully without it, since users, sessions, orders, products, rewards,
# and password resets all live here now.
DATABASE_URL=

# Stripe secret key for card checkout (leave blank to disable card payments)
STRIPE_SECRET_KEY=

# Stripe webhook signing secret (from the Stripe dashboard's webhook
# endpoint settings). Required for card orders to ever move out of
# "awaiting_payment" via the webhook — leave blank only if you're not
# accepting card payments.
STRIPE_WEBHOOK_SECRET=

# Public URL used for Stripe redirects
PUBLIC_URL=http://localhost:3000

# Port the server listens on. Render sets this automatically — you
# normally don't need to set it yourself outside local development.
PORT=3000

# All data lives in PostgreSQL (see DATABASE_URL above) — there is no
# local backup mechanism to configure. Back up Postgres itself: Neon
# point-in-time recovery, or a scheduled pg_dump.

# Email (used for password-reset links). Leave all of these blank during
# local development — the reset link will be logged to the server console
# and echoed back in the API response instead of emailed, so you can still
# test the full flow without an inbox. Fill these in with real SMTP
# credentials (e.g. from SendGrid, Mailgun, Postmark, or your own mail
# server) before deploying, so real customers actually receive their link.
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
EMAIL_FROM=MyShopSwift <no-reply@yourdomain.com>

# The one authorized admin login email (info@myshopswift.co.uk in
# production) — also where new-order notifications and admin
# first-time-setup/forgot-password temporary passwords are sent. Uses the
# same SMTP_* settings above, no second email system. Required for admin
# login to work at all; leave blank only to skip admin order-notification
# emails during local development (dashboard/browser notifications still
# work without this, but admin login will refuse all attempts).
ADMIN_EMAIL=

# Do NOT add an ADMIN_PASSWORD here. The permanent admin password is never
# stored in .env — only as a bcrypt hash in the admin_auth table in
# PostgreSQL, set via the admin login page's first-time setup flow.

# Inbox address shown/used for the customer-facing contact form. Falls back
# to SMTP_USER if left blank.
CONTACT_INBOX_EMAIL=

# ---------- AI shopping assistant (server-side only — never expose these) ----------
# OpenAI API key. Leave blank to disable the assistant; the storefront then
# hides the chat widget and everything else works as before.
OPENAI_API_KEY=

# Optional. Model used for the assistant (default: gpt-5-mini). Check the model
# name is available on your OpenAI account.
OPENAI_MODEL=

# Optional cost controls. Messages allowed per visitor per 15 minutes (default 30)
# and per day across the whole site (default 1500).
AI_RATE_LIMIT_MAX=30
AI_DAILY_LIMIT=1500

# ---------- Customer SMS order notifications (Twilio) — server-side only ----------
# Leave these blank to keep SMS switched off: the shop, checkout and email all
# work exactly as before. Never put these in frontend code or public files.
# Account SID and Auth Token: Twilio Console > Account info.
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
# Sender shown on the customer's phone. EITHER an alphanumeric sender ID
# (3-11 characters, letters/numbers/spaces, at least one letter, e.g.
# MyShopSwift — UK networks only, customers cannot reply to it) OR a Twilio
# number in E.164 format (e.g. +447700900123).
TWILIO_FROM=
# Optional alternative to TWILIO_FROM: a Twilio Messaging Service SID — "MG"
# followed by 32 letters/digits (34 characters), from Twilio Console >
# Messaging > Services. Enter it WITHOUT quotes. If set, it is the only sender
# used and TWILIO_FROM is ignored. A value in any other format switches SMS
# off (with the reason in the server log) rather than failing every send.
TWILIO_MESSAGING_SERVICE_SID=
# Optional kill switch: set to false to stop all SMS without removing the keys.
SMS_ENABLED=true
# Delivery reports (delivered / undelivered in the admin dashboard) are
# switched on automatically when PUBLIC_URL above is a public https:// URL;
# Twilio calls {PUBLIC_URL}/api/sms/twilio-status, and every call is
# signature-verified with TWILIO_AUTH_TOKEN. Nothing extra to configure.

# Set to production on the live server: makes login cookies Secure and
# disables the dev-only password-reset link fallback.
NODE_ENV=production

# Admin OTP destination in E.164 format; required for admin sign-in, e.g. +447700900123
ADMIN_PHONE=

# ---------- Cloudinary image storage (admin photos, category photos, brand flyers) ----------
# Server-side only: the API secret never goes to the browser. Find all three on
# the Cloudinary console > Settings > API Keys. Without them, photo/flyer
# uploads are refused (existing images keep displaying) until they are set.
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
# Optional: top-level Cloudinary folder (default "myshopswift"). Use a different
# value for a staging site so test uploads don't mix with production images.
# CLOUDINARY_FOLDER=myshopswift
