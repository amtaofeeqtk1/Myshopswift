# Admin access for the client admin panel
ADMIN_KEY=replace-with-a-strong-admin-key

# PostgreSQL connection string (Neon). Required — the app will not start
# usefully without it, since users, sessions, orders, products, rewards,
# and password resets all live here now.
DATABASE_URL=

# Stripe secret key for card checkout (leave blank to disable card payments)
STRIPE_SECRET_KEY=

# Stripe webhook signing secret (from the Stripe dashboard's webhook
# endpoint settings). Required for card orders to ever move out of
# "awaiting_payment" via the webhook — leave blank only if you're not
# accepting card payments.
STRIPE_WEBHOOK_SECRET=

# Public URL used for Stripe redirects
PUBLIC_URL=http://localhost:3000

# Port the server listens on. Render sets this automatically — you
# normally don't need to set it yourself outside local development.
PORT=3000

# All data lives in PostgreSQL (see DATABASE_URL above) — there is no
# local backup mechanism to configure. Back up Postgres itself: Neon
# point-in-time recovery, or a scheduled pg_dump.

# Email (used for password-reset links). Leave all of these blank during
# local development — the reset link will be logged to the server console
# and echoed back in the API response instead of emailed, so you can still
# test the full flow without an inbox. Fill these in with real SMTP
# credentials (e.g. from SendGrid, Mailgun, Postmark, or your own mail
# server) before deploying, so real customers actually receive their link.
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
EMAIL_FROM=MyShopSwift <no-reply@yourdomain.com>

# Admin email address that receives new-order notifications. Uses the same
# SMTP_* settings above (also used for password-reset emails) — no second
# email system. Leave blank to skip admin emails (dashboard/browser
# notifications still work without this).
ADMIN_EMAIL=

# Inbox address shown/used for the customer-facing contact form. Falls back
# to SMTP_USER if left blank.
CONTACT_INBOX_EMAIL=
